NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ntorq-companion?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32_characters_minimum
JWT_EXPIRES_IN=30d
ALLOW_REGISTRATION=false
CORS_ORIGIN=http://localhost:5173

# Optional: Cloudinary for receipts and document attachments
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Web Push Notifications (generate via npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@ntorq-companion.local
